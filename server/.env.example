# Server environment variables (names only). Copy to server/.env for local
# development; real values live on Render and are never committed.

# Core
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRE=
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRE=
PORT=
NODE_ENV=
CLIENT_URL=
FRONTEND_URL=
SERVER_URL=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# AI
ANTHROPIC_API_KEY=

# Email
SENDGRID_API_KEY=
EMAIL_FROM=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_PERCENT=

# Epic
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=
EPIC_REDIRECT_URI=
EPIC_AUTHORIZE_URL=
EPIC_TOKEN_URL=
EPIC_FHIR_BASE_URL=
EPIC_SECRET_ENCRYPTION_KEY=

# Insurers
WELLMARK_SANDBOX_KEY=
WELLMARK_PRODUCTION_KEY=
WELLMARK_FHIR_BASE_URL=
WELLMARK_AUTH_URL=
WELLMARK_TOKEN_URL=
HUMANA_CLIENT_ID=
HUMANA_CLIENT_SECRET=
HUMANA_FHIR_BASE_URL=
HUMANA_AUTH_URL=
HUMANA_TOKEN_URL=

# Other
INVESTOR_PASSCODE=

# Palantir Foundry bridge (docs/foundry-bridge.md). Leave FOUNDRY_WRITES empty
# to keep the bridge fully off; 1 turns it on (test members only until a HIPAA BAA).
FOUNDRY_WRITES=
FOUNDRY_URL=
FOUNDRY_TOKEN=
FOUNDRY_ONTOLOGY_RID=
